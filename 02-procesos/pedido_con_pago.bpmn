<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs" targetNamespace="http://example.com/bpmn">
<bpmn:collaboration id="Collab">
<bpmn:participant id="Participant_Cliente" name="Cliente" processRef="P_Cliente" />
<bpmn:participant id="Participant_Tienda" name="Tienda" processRef="P_Tienda" />
<bpmn:participant id="Participant_Pasarela" name="Pasarela de pago" processRef="P_Pasarela" />
<bpmn:messageFlow id="m0" sourceRef="T_ConfirmarC" targetRef="S_Pedido" />
<bpmn:messageFlow id="m1" sourceRef="T_SolMedio" targetRef="E_MedioSolic" />
<bpmn:messageFlow id="m2" sourceRef="T_Ingresar" targetRef="E_MedioRecib" />
<bpmn:messageFlow id="m3" sourceRef="T_SolCobro" targetRef="S_Cobro" />
<bpmn:messageFlow id="m4" sourceRef="T_Procesar" targetRef="E_Resp" />
<bpmn:messageFlow id="m5" sourceRef="End_SinStock" targetRef="Participant_Cliente" />
<bpmn:messageFlow id="m6" sourceRef="End_Cancelado" targetRef="Participant_Cliente" />
<bpmn:messageFlow id="m7" sourceRef="T_MailPend" targetRef="Participant_Cliente" />
</bpmn:collaboration>
<bpmn:process id="P_Cliente" isExecutable="false">
<bpmn:startEvent id="Start_C" name="Inicio"><bpmn:outgoing>PC_f0</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="T_ConfirmarC" name="Confirmar pedido"><bpmn:incoming>PC_f0</bpmn:incoming><bpmn:outgoing>PC_f1</bpmn:outgoing></bpmn:userTask>
<bpmn:intermediateCatchEvent id="E_MedioSolic" name="Medio de pago solicitado"><bpmn:incoming>PC_f1</bpmn:incoming><bpmn:outgoing>PC_f2</bpmn:outgoing><bpmn:messageEventDefinition /></bpmn:intermediateCatchEvent>
<bpmn:userTask id="T_Ingresar" name="Ingresar medio de pago"><bpmn:incoming>PC_f2</bpmn:incoming><bpmn:outgoing>PC_f3</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="End_C" name="Fin"><bpmn:incoming>PC_f3</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="PC_f0" name="" sourceRef="Start_C" targetRef="T_ConfirmarC" />
<bpmn:sequenceFlow id="PC_f1" name="" sourceRef="T_ConfirmarC" targetRef="E_MedioSolic" />
<bpmn:sequenceFlow id="PC_f2" name="" sourceRef="E_MedioSolic" targetRef="T_Ingresar" />
<bpmn:sequenceFlow id="PC_f3" name="" sourceRef="T_Ingresar" targetRef="End_C" />
</bpmn:process>
<bpmn:process id="P_Tienda" isExecutable="false">
<bpmn:laneSet id="LS">
<bpmn:lane id="Lane_Ventas" name="Ventas"><bpmn:flowNodeRef>S_Pedido</bpmn:flowNodeRef><bpmn:flowNodeRef>T_GuardarPend</bpmn:flowNodeRef><bpmn:flowNodeRef>SP_Cobro</bpmn:flowNodeRef><bpmn:flowNodeRef>BE_Timer</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Cancelar</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Cancelado</bpmn:flowNodeRef><bpmn:flowNodeRef>T_ConfEstado</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Split</bpmn:flowNodeRef><bpmn:flowNodeRef>T_MailFactura</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Join</bpmn:flowNodeRef><bpmn:flowNodeRef>End_OK</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_Almacen" name="Almacén"><bpmn:flowNodeRef>T_Verificar</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Stock</bpmn:flowNodeRef><bpmn:flowNodeRef>End_SinStock</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Descontar</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Preparar</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="S_Pedido" name="Pedido recibido"><bpmn:outgoing>PT_f0</bpmn:outgoing><bpmn:messageEventDefinition /></bpmn:startEvent>
<bpmn:serviceTask id="T_Verificar" name="Verificar stock de cada ítem"><bpmn:incoming>PT_f0</bpmn:incoming><bpmn:outgoing>PT_f1</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="GW_Stock" name="¿Hay stock?"><bpmn:incoming>PT_f1</bpmn:incoming><bpmn:outgoing>PT_f2</bpmn:outgoing><bpmn:outgoing>PT_f3</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="End_SinStock" name="Pedido rechazado (sin stock)"><bpmn:incoming>PT_f2</bpmn:incoming><bpmn:messageEventDefinition /></bpmn:endEvent>
<bpmn:serviceTask id="T_GuardarPend" name="Guardar pedido (pendiente de pago)"><bpmn:incoming>PT_f3</bpmn:incoming><bpmn:outgoing>PT_f4</bpmn:outgoing></bpmn:serviceTask>
<bpmn:subProcess id="SP_Cobro" name="Cobrar el pedido"><bpmn:incoming>PT_f4</bpmn:incoming><bpmn:outgoing>PT_f7</bpmn:outgoing>
<bpmn:startEvent id="SP_Start" name="Pedido guardado"><bpmn:outgoing>PTI_f0</bpmn:outgoing></bpmn:startEvent>
<bpmn:sendTask id="T_SolMedio" name="Solicitar medio de pago"><bpmn:incoming>PTI_f0</bpmn:incoming><bpmn:incoming>PTI_f7</bpmn:incoming><bpmn:outgoing>PTI_f1</bpmn:outgoing></bpmn:sendTask>
<bpmn:intermediateCatchEvent id="E_MedioRecib" name="Medio de pago recibido"><bpmn:incoming>PTI_f1</bpmn:incoming><bpmn:outgoing>PTI_f2</bpmn:outgoing><bpmn:messageEventDefinition /></bpmn:intermediateCatchEvent>
<bpmn:sendTask id="T_SolCobro" name="Solicitar cobro"><bpmn:incoming>PTI_f2</bpmn:incoming><bpmn:outgoing>PTI_f3</bpmn:outgoing></bpmn:sendTask>
<bpmn:intermediateCatchEvent id="E_Resp" name="Respuesta de cobro recibida"><bpmn:incoming>PTI_f3</bpmn:incoming><bpmn:outgoing>PTI_f4</bpmn:outgoing><bpmn:messageEventDefinition /></bpmn:intermediateCatchEvent>
<bpmn:serviceTask id="T_Reg" name="Registrar cobro"><bpmn:incoming>PTI_f4</bpmn:incoming><bpmn:outgoing>PTI_f5</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="GW_Cobro" name="¿Cobro aprobado?"><bpmn:incoming>PTI_f5</bpmn:incoming><bpmn:outgoing>PTI_f6</bpmn:outgoing><bpmn:outgoing>PTI_f8</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="T_MailPend" name="Enviar mail: pedido sigue pendiente"><bpmn:incoming>PTI_f6</bpmn:incoming><bpmn:outgoing>PTI_f7</bpmn:outgoing></bpmn:sendTask>
<bpmn:endEvent id="SP_End" name="Cobro aprobado"><bpmn:incoming>PTI_f8</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="PTI_f0" name="" sourceRef="SP_Start" targetRef="T_SolMedio" />
<bpmn:sequenceFlow id="PTI_f1" name="" sourceRef="T_SolMedio" targetRef="E_MedioRecib" />
<bpmn:sequenceFlow id="PTI_f2" name="" sourceRef="E_MedioRecib" targetRef="T_SolCobro" />
<bpmn:sequenceFlow id="PTI_f3" name="" sourceRef="T_SolCobro" targetRef="E_Resp" />
<bpmn:sequenceFlow id="PTI_f4" name="" sourceRef="E_Resp" targetRef="T_Reg" />
<bpmn:sequenceFlow id="PTI_f5" name="" sourceRef="T_Reg" targetRef="GW_Cobro" />
<bpmn:sequenceFlow id="PTI_f6" name="No" sourceRef="GW_Cobro" targetRef="T_MailPend" />
<bpmn:sequenceFlow id="PTI_f7" name="Reintento" sourceRef="T_MailPend" targetRef="T_SolMedio" />
<bpmn:sequenceFlow id="PTI_f8" name="Sí" sourceRef="GW_Cobro" targetRef="SP_End" />
</bpmn:subProcess>
<bpmn:boundaryEvent id="BE_Timer" name="Pasaron 24 h" attachedToRef="SP_Cobro" cancelActivity="true"><bpmn:outgoing>PT_f5</bpmn:outgoing><bpmn:timerEventDefinition /></bpmn:boundaryEvent>
<bpmn:serviceTask id="T_Cancelar" name="Cancelar pedido"><bpmn:incoming>PT_f5</bpmn:incoming><bpmn:outgoing>PT_f6</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="End_Cancelado" name="Pedido cancelado"><bpmn:incoming>PT_f6</bpmn:incoming><bpmn:messageEventDefinition /></bpmn:endEvent>
<bpmn:serviceTask id="T_ConfEstado" name="Confirmar pedido"><bpmn:incoming>PT_f7</bpmn:incoming><bpmn:outgoing>PT_f8</bpmn:outgoing></bpmn:serviceTask>
<bpmn:parallelGateway id="GW_Split" name=""><bpmn:incoming>PT_f8</bpmn:incoming><bpmn:outgoing>PT_f9</bpmn:outgoing><bpmn:outgoing>PT_f10</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:serviceTask id="T_MailFactura" name="Enviar mail con factura"><bpmn:incoming>PT_f9</bpmn:incoming><bpmn:outgoing>PT_f12</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="T_Descontar" name="Descontar stock"><bpmn:incoming>PT_f10</bpmn:incoming><bpmn:outgoing>PT_f11</bpmn:outgoing></bpmn:serviceTask>
<bpmn:manualTask id="T_Preparar" name="Preparar pedido"><bpmn:incoming>PT_f11</bpmn:incoming><bpmn:outgoing>PT_f13</bpmn:outgoing></bpmn:manualTask>
<bpmn:parallelGateway id="GW_Join" name=""><bpmn:incoming>PT_f12</bpmn:incoming><bpmn:incoming>PT_f13</bpmn:incoming><bpmn:outgoing>PT_f14</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:endEvent id="End_OK" name="Pedido confirmado"><bpmn:incoming>PT_f14</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="PT_f0" name="" sourceRef="S_Pedido" targetRef="T_Verificar" />
<bpmn:sequenceFlow id="PT_f1" name="" sourceRef="T_Verificar" targetRef="GW_Stock" />
<bpmn:sequenceFlow id="PT_f2" name="No" sourceRef="GW_Stock" targetRef="End_SinStock" />
<bpmn:sequenceFlow id="PT_f3" name="Sí" sourceRef="GW_Stock" targetRef="T_GuardarPend" />
<bpmn:sequenceFlow id="PT_f4" name="" sourceRef="T_GuardarPend" targetRef="SP_Cobro" />
<bpmn:sequenceFlow id="PT_f5" name="" sourceRef="BE_Timer" targetRef="T_Cancelar" />
<bpmn:sequenceFlow id="PT_f6" name="" sourceRef="T_Cancelar" targetRef="End_Cancelado" />
<bpmn:sequenceFlow id="PT_f7" name="" sourceRef="SP_Cobro" targetRef="T_ConfEstado" />
<bpmn:sequenceFlow id="PT_f8" name="" sourceRef="T_ConfEstado" targetRef="GW_Split" />
<bpmn:sequenceFlow id="PT_f9" name="" sourceRef="GW_Split" targetRef="T_MailFactura" />
<bpmn:sequenceFlow id="PT_f10" name="" sourceRef="GW_Split" targetRef="T_Descontar" />
<bpmn:sequenceFlow id="PT_f11" name="" sourceRef="T_Descontar" targetRef="T_Preparar" />
<bpmn:sequenceFlow id="PT_f12" name="" sourceRef="T_MailFactura" targetRef="GW_Join" />
<bpmn:sequenceFlow id="PT_f13" name="" sourceRef="T_Preparar" targetRef="GW_Join" />
<bpmn:sequenceFlow id="PT_f14" name="" sourceRef="GW_Join" targetRef="End_OK" />
</bpmn:process>
<bpmn:process id="P_Pasarela" isExecutable="false">
<bpmn:startEvent id="S_Cobro" name="Cobro solicitado"><bpmn:outgoing>PP_f0</bpmn:outgoing><bpmn:messageEventDefinition /></bpmn:startEvent>
<bpmn:serviceTask id="T_Procesar" name="Procesar pago"><bpmn:incoming>PP_f0</bpmn:incoming><bpmn:outgoing>PP_f1</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="End_P" name="Cobro procesado"><bpmn:incoming>PP_f1</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="PP_f0" name="" sourceRef="S_Cobro" targetRef="T_Procesar" />
<bpmn:sequenceFlow id="PP_f1" name="" sourceRef="T_Procesar" targetRef="End_P" />
</bpmn:process>
