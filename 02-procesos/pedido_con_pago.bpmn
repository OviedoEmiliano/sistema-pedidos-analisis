<bpmn:messageFlow id="m0" sourceRef="T_ConfirmarC" targetRef="S_Pedido" />
<bpmn:messageFlow id="m1" sourceRef="T_SolMedio" targetRef="E_MedioSolic" />
<bpmn:messageFlow id="m2" sourceRef="T_Ingresar" targetRef="E_MedioRecib" />
<bpmn:messageFlow id="m3" sourceRef="T_SolCobro" targetRef="S_Cobro" />
<bpmn:messageFlow id="m4" sourceRef="T_Procesar" targetRef="E_Resp" />
<bpmn:messageFlow id="m5" sourceRef="End_SinStock" targetRef="Participant_Cliente" />
<bpmn:messageFlow id="m6" sourceRef="End_Cancelado" targetRef="Participant_Cliente" />
<bpmn:messageFlow id="m7" sourceRef="T_MailPend" targetRef="Participant_Cliente" />
</bpmn:collaboration>
<bpmn:process id="P_Cliente" isExecutable="false">
<bpmn:startEvent id="Start_C" name="Inicio"><bpmn:outgoing>PC_f0</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="T_ConfirmarC" name="Confirmar pedido"><bpmn:incoming>PC_f0</bpmn:incoming><bpmn:outgoing>PC_f1</bpmn:outgoing></bpmn:userTask>
<bpmn:intermediateCatchEvent id="E_MedioSolic" name="Medio de pago solicitado"><bpmn:incoming>PC_f1</bpmn:incoming><bpmn:outgoing>PC_f2</bpmn:outgoing><bpmn:messageEventDefinition /></bpmn:intermediateCatchEvent>
<bpmn:userTask id="T_Ingresar" name="Ingresar medio de pago"><bpmn:incoming>PC_f2</bpmn:incoming><bpmn:outgoing>PC_f3</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="End_C" name="Fin"><bpmn:incoming>PC_f3</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="PC_f0" name="" sourceRef="Start_C" targetRef="T_ConfirmarC" />
<bpmn:sequenceFlow id="PC_f1" name="" sourceRef="T_ConfirmarC" targetRef="E_MedioSolic" />
<bpmn:sequenceFlow id="PC_f2" name="" sourceRef="E_MedioSolic" targetRef="T_Ingresar" />
<bpmn:sequenceFlow id="PC_f3" name="" sourceRef="T_Ingresar" targetRef="End_C" />
</bpmn:process>
<bpmn:process id="P_Tienda" isExecutable="false">
<bpmn:laneSet id="LS">
<bpmn:lane id="Lane_Ventas" name="Ventas"><bpmn:flowNodeRef>S_Pedido</bpmn:flowNodeRef><bpmn:flowNodeRef>T_GuardarPend</bpmn:flowNodeRef><bpmn:flowNodeRef>T_SolMedio</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Evt</bpmn:flowNodeRef><bpmn:flowNodeRef>Timer</bpmn:flowNodeRef><bpmn:flowNodeRef>E_MedioRecib</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Cancelar</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Cancelado</bpmn:flowNodeRef><bpmn:flowNodeRef>T_SolCobro</bpmn:flowNodeRef><bpmn:flowNodeRef>E_Resp</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Reg</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Cobro</bpmn:flowNodeRef><bpmn:flowNodeRef>T_MailPend</bpmn:flowNodeRef><bpmn:flowNodeRef>T_ConfEstado</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Split</bpmn:flowNodeRef><bpmn:flowNodeRef>T_MailFactura</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Join</bpmn:flowNodeRef><bpmn:flowNodeRef>End_OK</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_Almacen" name="Almacén"><bpmn:flowNodeRef>T_Verificar</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Stock</bpmn:flowNodeRef><bpmn:flowNodeRef>End_SinStock</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Descontar</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Preparar</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="S_Pedido" name="Pedido recibido"><bpmn:outgoing>PT_f0</bpmn:outgoing><bpmn:messageEventDefinition /></bpmn:startEvent>
<bpmn:serviceTask id="T_Verificar" name="Verificar stock de cada ítem"><bpmn:incoming>PT_f0</bpmn:incoming><bpmn:outgoing>PT_f1</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="GW_Stock" name="¿Hay stock?"><bpmn:incoming>PT_f1</bpmn:incoming><bpmn:outgoing>PT_f2</bpmn:outgoing><bpmn:outgoing>PT_f3</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="End_SinStock" name="Pedido rechazado (sin stock)"><bpmn:incoming>PT_f2</bpmn:incoming><bpmn:messageEventDefinition /></bpmn:endEvent>
<bpmn:serviceTask id="T_GuardarPend" name="Guardar pedido (pendiente de pago)"><bpmn:incoming>PT_f3</bpmn:incoming><bpmn:outgoing>PT_f4</bpmn:outgoing></bpmn:serviceTask>
<bpmn:sendTask id="T_SolMedio" name="Solicitar medio de pago"><bpmn:incoming>PT_f4</bpmn:incoming><bpmn:incoming>PT_f15</bpmn:incoming><bpmn:outgoing>PT_f5</bpmn:outgoing></bpmn:sendTask>
<bpmn:eventBasedGateway id="GW_Evt" name="Espera de respuesta"><bpmn:incoming>PT_f5</bpmn:incoming><bpmn:outgoing>PT_f6</bpmn:outgoing><bpmn:outgoing>PT_f7</bpmn:outgoing></bpmn:eventBasedGateway>
<bpmn:intermediateCatchEvent id="Timer" name="Pasaron 24 h"><bpmn:incoming>PT_f7</bpmn:incoming><bpmn:outgoing>PT_f8</bpmn:outgoing><bpmn:timerEventDefinition /></bpmn:intermediateCatchEvent>
<bpmn:intermediateCatchEvent id="E_MedioRecib" name="Medio de pago recibido"><bpmn:incoming>PT_f6</bpmn:incoming><bpmn:outgoing>PT_f10</bpmn:outgoing><bpmn:messageEventDefinition /></bpmn:intermediateCatchEvent>
<bpmn:serviceTask id="T_Cancelar" name="Cancelar pedido"><bpmn:incoming>PT_f8</bpmn:incoming><bpmn:outgoing>PT_f9</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="End_Cancelado" name="Pedido cancelado"><bpmn:incoming>PT_f9</bpmn:incoming><bpmn:messageEventDefinition /></bpmn:endEvent>
<bpmn:sendTask id="T_SolCobro" name="Solicitar cobro"><bpmn:incoming>PT_f10</bpmn:incoming><bpmn:outgoing>PT_f11</bpmn:outgoing></bpmn:sendTask>
<bpmn:intermediateCatchEvent id="E_Resp" name="Respuesta de cobro recibida"><bpmn:incoming>PT_f11</bpmn:incoming><bpmn:outgoing>PT_f12</bpmn:outgoing><bpmn:messageEventDefinition /></bpmn:intermediateCatchEvent>
<bpmn:serviceTask id="T_Reg" name="Registrar cobro"><bpmn:incoming>PT_f12</bpmn:incoming><bpmn:outgoing>PT_f13</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="GW_Cobro" name="¿Cobro aprobado?"><bpmn:incoming>PT_f13</bpmn:incoming><bpmn:outgoing>PT_f14</bpmn:outgoing><bpmn:outgoing>PT_f16</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="T_MailPend" name="Enviar mail: pedido sigue pendiente"><bpmn:incoming>PT_f14</bpmn:incoming><bpmn:outgoing>PT_f15</bpmn:outgoing></bpmn:sendTask>
<bpmn:serviceTask id="T_ConfEstado" name="Confirmar pedido"><bpmn:incoming>PT_f16</bpmn:incoming><bpmn:outgoing>PT_f17</bpmn:outgoing></bpmn:serviceTask>
<bpmn:parallelGateway id="GW_Split" name=""><bpmn:incoming>PT_f17</bpmn:incoming><bpmn:outgoing>PT_f18</bpmn:outgoing><bpmn:outgoing>PT_f19</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:serviceTask id="T_MailFactura" name="Enviar mail con factura"><bpmn:incoming>PT_f18</bpmn:incoming><bpmn:outgoing>PT_f21</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="T_Descontar" name="Descontar stock"><bpmn:incoming>PT_f19</bpmn:incoming><bpmn:outgoing>PT_f20</bpmn:outgoing></bpmn:serviceTask>
<bpmn:manualTask id="T_Preparar" name="Preparar pedido"><bpmn:incoming>PT_f20</bpmn:incoming><bpmn:outgoing>PT_f22</bpmn:outgoing></bpmn:manualTask>
<bpmn:parallelGateway id="GW_Join" name=""><bpmn:incoming>PT_f21</bpmn:incoming><bpmn:incoming>PT_f22</bpmn:incoming><bpmn:outgoing>PT_f23</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:endEvent id="End_OK" name="Pedido confirmado"><bpmn:incoming>PT_f23</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="PT_f0" name="" sourceRef="S_Pedido" targetRef="T_Verificar" />
<bpmn:sequenceFlow id="PT_f1" name="" sourceRef="T_Verificar" targetRef="GW_Stock" />
<bpmn:sequenceFlow id="PT_f2" name="No" sourceRef="GW_Stock" targetRef="End_SinStock" />
