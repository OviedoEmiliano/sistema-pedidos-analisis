<bpmn:sequenceFlow id="PT_f13" name="" sourceRef="T_Reg" targetRef="GW_Cobro" />
<bpmn:sequenceFlow id="PT_f14" name="No" sourceRef="GW_Cobro" targetRef="T_MailPend" />
<bpmn:sequenceFlow id="PT_f15" name="Reintento" sourceRef="T_MailPend" targetRef="T_SolMedio" />
<bpmn:sequenceFlow id="PT_f16" name="Sí" sourceRef="GW_Cobro" targetRef="T_ConfEstado" />
<bpmn:sequenceFlow id="PT_f17" name="" sourceRef="T_ConfEstado" targetRef="GW_Split" />
<bpmn:sequenceFlow id="PT_f18" name="" sourceRef="GW_Split" targetRef="T_MailFactura" />
<bpmn:sequenceFlow id="PT_f19" name="" sourceRef="GW_Split" targetRef="T_Descontar" />
<bpmn:sequenceFlow id="PT_f20" name="" sourceRef="T_Descontar" targetRef="T_Preparar" />
<bpmn:sequenceFlow id="PT_f21" name="" sourceRef="T_MailFactura" targetRef="GW_Join" />
<bpmn:sequenceFlow id="PT_f22" name="" sourceRef="T_Preparar" targetRef="GW_Join" />
<bpmn:sequenceFlow id="PT_f23" name="" sourceRef="GW_Join" targetRef="End_OK" />
</bpmn:process>
<bpmn:process id="P_Pasarela" isExecutable="false">
<bpmn:startEvent id="S_Cobro" name="Cobro solicitado"><bpmn:outgoing>PP_f0</bpmn:outgoing><bpmn:messageEventDefinition /></bpmn:startEvent>
<bpmn:serviceTask id="T_Procesar" name="Procesar pago"><bpmn:incoming>PP_f0</bpmn:incoming><bpmn:outgoing>PP_f1</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="End_P" name="Cobro procesado"><bpmn:incoming>PP_f1</bpmn:incoming></bpmn:endEvent>
